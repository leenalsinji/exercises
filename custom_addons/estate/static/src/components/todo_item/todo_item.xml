<t t-name="estate.TodoItem">
    <div class="d-flex align-items-center mb-2 p-2 border-bottom" 
         t-att-class="props.todo.isCompleted ? 'text-muted text-decoration-line-through' : ''">
        <input type="checkbox" class="me-2" t-att-checked="props.todo.isCompleted"
               t-on-change="() => props.toggleState(props.todo.id)"/>
        <span class="flex-grow-1"><t t-esc="props.todo.id"/>. <t t-esc="props.todo.description"/></span>
        <span class="fa fa-remove text-danger cursor-pointer" t-on-click="() => props.removeTodo(props.todo.id)"/>
    </div>
</t>