<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="report_property_offers_table">
        <t t-if="offers">
            <table class="table mt32">
                <thead>
                    <tr>
                        <th>Price</th>
                        <th>Partner</th>
                        <th>Validity (days)</th>
                        <th>Deadline</th>
                        <th>State</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="offers" t-as="offer">
                        <td><span t-field="offer.price"/></td>
                        <td><span t-field="offer.partner_id"/></td>
                        <td><span t-field="offer.validity"/></td>
                        <td><span t-field="offer.date_deadline"/></td>
                        <td><span t-field="offer.status"/></td>
                    </tr>
                </tbody>
            </table>
        </t>
        <t t-else="">
            <p class="mt32">No offers have been made yet !</p>
        </t>
    </template>

  <template id="report_property_offers">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="property">
            <t t-call="web.external_layout">
                <div class="page">
                    <h1>Salesman: <span t-field="property.salesperson_id"/></h1>
                    
                    <h2><span t-field="property.name"/></h2>
                    
                    <div>
                        <strong>Expected Price: </strong>
                        <span t-field="property.expected_price"/>
                    </div>
                    <div>
                        <strong>Status: </strong>
                        <span t-field="property.state"/>
                    </div>

                    <t t-if="property.state == 'sold'">
                        <div class="mt16 text-danger" style="font-weight: bold; border: 2px solid red; padding: 5px; display: inline-block;">
                            !!! Invoice has already been created !!!
                        </div>
                    </t>

                    <t t-set="offers" t-value="property.offer_ids"/>
                    <t t-call="estate.report_property_offers_table"/>
                </div>
            </t>
        </t>
    </t>
</template>
<template id="report_salesman_properties">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="user">
            <t t-call="web.external_layout">
                <div class="page">
                    <h1>Salesman: <span t-field="user.name"/></h1>
                    
                    <t t-foreach="user.property_ids" t-as="property">
                        <h3><span t-field="property.name"/></h3>
                        
                        <t t-set="offers" t-value="property.offer_ids"/>
                        <t t-call="estate.report_property_offers_table"/>
                    </t>
                </div>
            </t>
        </t>
    </t>
</template>

</odoo>